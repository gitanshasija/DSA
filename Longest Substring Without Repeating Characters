class Solution {
    public int lengthOfLongestSubstring(String s) {
        int n = s.length();
        boolean[] arr = new boolean[128];
        int maxLen = 0, r = 0, l = 0;

        while (r < n) {
            if (!arr[s.charAt(r)]) {
                arr[s.charAt(r)] = true;
                maxLen = Math.max(maxLen, r - l + 1);
                r++;
            } 
            else {
                arr[s.charAt(l)] = false;
                l++;
            }
        }
        return maxLen;
    }
}
