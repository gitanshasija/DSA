class Solution {
    public boolean canReach(String s, int minJump, int maxJump) {
        int n = s.length();
        boolean[] reach = new boolean[n];

        reach[0] = true;
        int count = 0;

        for(int j = 1; j < n; j++){
            if( j-minJump >= 0 && reach[j - minJump]){
                count++;
            }

            if( j-maxJump-1 >= 0 && reach[j-maxJump-1]){
                count--;
            }
            reach[j] = count>0 && s.charAt(j) == '0';
        }
        return reach[n-1];
    }
}
